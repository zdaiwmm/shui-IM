{
  "name": "Quiet Room",
  "short_name": "Quiet Room",
  "description": "A private two-person encrypted room.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "lang": "zh-CN",
  "dir": "ltr",
  "background_color": "#f4f6fa",
  "theme_color": "transparent",
  "launch_handler": { "client_mode": "focus-existing" },
  "protocol_handlers": [{ "protocol": "web+quietroom", "url": "/?app-launch=%s" }],
  "related_applications": [{ "platform": "webapp", "url": "https://ai.shui.click/manifest.webmanifest" }],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
