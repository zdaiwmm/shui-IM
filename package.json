{
  "name": "quiet-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "env:check": "node scripts/environment-check.mjs",
    "device:debug": "python3 tools/iphone-debug/scripts/device.py",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/test-browser.mjs",
    "test:cloud-backup": "node tests/cloud-backup-lifecycle.e2e.mjs",
    "test:watch": "vitest",
    "expressions:initialize": "node scripts/initialize-expression-catalog.mjs",
    "check": "npm run build && npm run test",
    "check:full": "npm run check && npm run test:browser",
    "repo:doctor": "node scripts/repo.mjs doctor",
    "repo:pull": "node scripts/repo.mjs pull",
    "repo:push": "node scripts/repo.mjs push",
    "tasks:cleanup": "node scripts/cleanup-task-resources.mjs",
    "backup:create": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "backup:daemon": "node scripts/backup-loop.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "deploy:setup": "node scripts/deploy-setup.mjs",
    "deploy:production": "node scripts/publish.mjs",
    "deploy:production:direct": "bash scripts/deploy-production.sh",
    "deploy:doctor": "bash scripts/deploy-production.sh --doctor",
    "deploy:readback": "node scripts/production-readback.mjs",
    "test:calls": "vitest run tests/call-crypto.test.ts tests/call-membership.test.ts tests/call-controller.test.ts tests/call-server.test.ts && npm run test:calls:e2e",
    "test:calls:e2e": "node tests/call-native.e2e.mjs && node tests/call-view.e2e.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.3.0",
    "@zip.js/zip.js": "2.13.1",
    "dompurify": "3.4.15",
    "epubjs": "0.3.93",
    "exifr": "7.1.3",
    "hash-wasm": "4.12.0",
    "lucide": "0.468.0",
    "pdfjs-dist": "6.3.289",
    "protobufjs": "8.8.0",
    "qrcode": "1.5.4",
    "ts-mls": "1.6.4",
    "web-push": "3.6.7",
    "ws": "8.21.3"
  },
  "overrides": {
    "epubjs": { "@xmldom/xmldom": "0.9.12" }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
