{
  "name": "quiet-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser.e2e.mjs && node tests/frontend-lifecycle.e2e.mjs && node tests/vault-lifecycle.e2e.mjs && node tests/voice-lifecycle.e2e.mjs",
    "test:watch": "vitest",
    "check": "npm run build && npm run test",
    "check:full": "npm run check && npm run test:browser",
    "backup:create": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "backup:daemon": "node scripts/backup-loop.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "deploy:production": "bash scripts/deploy-production.sh"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.3.0",
    "hash-wasm": "4.12.0",
    "qrcode": "1.5.4",
    "ts-mls": "1.6.4",
    "web-push": "3.6.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
