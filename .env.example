# Bind to 0.0.0.0 only behind an HTTPS reverse proxy or private network boundary.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Ciphertext/resource controls. Adjust only after capacity testing.
MAX_BLOB_BYTES=268437504
MAX_ROOM_STORAGE_BYTES=1073741824
MAX_TOTAL_STORAGE_BYTES=10737418240
MAX_INCOMPLETE_BLOBS=4
MAX_MESSAGES_PER_ROOM=100000
MAX_ROOM_MESSAGE_BYTES=536870912
MAX_CONNECTIONS_PER_ROOM=8
MAX_CONNECTIONS_TOTAL=1000
INCOMPLETE_BLOB_TTL_MS=86400000
# Generate once with `npm run push:keys`; keep the private key in a secret manager.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
# Point this at storage replicated to a different failure domain in production.
QUIET_ROOM_BACKUP_DIR=./backups
BACKUP_INTERVAL_MS=86400000
BACKUP_RETENTION_COUNT=14
