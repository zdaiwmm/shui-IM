# Copy to .env.calls, protect file permissions, and fill in the actual values.
# Credentials issued to devices expire after two hours.
# Generate a 32-byte base64url secret; share it only between chat backend and coturn.
TURN_SECRET=
TURN_PUBLIC_IP=
TURN_REALM=quiet-room
# Use a DNS name that resolves to TURN_PUBLIC_IP; placeholders must be replaced.
CALL_STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
CALL_RELAY_ONLY=false
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Open 3478/UDP, 3478/TCP and the above UDP range in the provider + host firewalls.
# Restrict other application/admin ports as before. Never publish the TURN secret.
# Optional encrypted TURN fallback: provide fullchain.pem + privkey.pem, enable TLS,
# open 5349/TCP, and append turns:turn.example.com:5349?transport=tcp to TURN_URLS.
# 443 is intentionally unused because the existing HTTPS site may own it.
TURN_TLS_ENABLED=false
TURN_TLS_DIR=./deploy/turn-tls
# Verify the upstream image/security updates and pin its digest before production.
COTURN_IMAGE=
