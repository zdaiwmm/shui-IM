#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

# Fixed phase names and elapsed time only: never log command arguments or
# environment values. Keep ERR/rollback handling independent of the EXIT log.
deploy_timing_started=$SECONDS
deploy_phase=''
deploy_phase_started=$SECONDS
deploy_phase_finish() {
  local result="$1"
  if [[ -n "$deploy_phase" ]]; then
    printf 'DEPLOY_TIMING phase=%s result=%s duration_ms=%s\n' \
      "$deploy_phase" "$result" "$(( (SECONDS - deploy_phase_started) * 1000 ))" >&2 || :
    deploy_phase=''
  fi
}
deploy_phase_start() {
  deploy_phase_finish success
  deploy_phase="$1"
  deploy_phase_started=$SECONDS
}
deploy_timing_exit() {
  local exit_code=$?
  local result=success
  trap - EXIT
  if (( exit_code != 0 )); then result=failure; fi
  deploy_phase_finish "$result"
  printf 'DEPLOY_TIMING phase=total result=%s duration_ms=%s\n' \
    "$result" "$(( (SECONDS - deploy_timing_started) * 1000 ))" >&2 || :
  exit "$exit_code"
}
trap deploy_timing_exit EXIT
deploy_phase_start preflight
# End of timing setup (also exercised by isolated cutover tests).

readonly APP_ROOT=/opt/quiet-room
readonly REPOSITORY="$APP_ROOT/repository.git"
readonly RELEASES="$APP_ROOT/git-releases"
readonly STATE_DIR="$APP_ROOT/deploy-state"
readonly BACKUP_DIR="$APP_ROOT/backups/predeploy"
readonly SHARED_ENV="$APP_ROOT/shared/production.env"
readonly CALLS_ENV="$APP_ROOT/shared/calls.env"
readonly CALLS_STATE="$STATE_DIR/calls-enabled"
readonly ADMIN_ENV="$APP_ROOT/shared/admin.env"
readonly ADMIN_STATE="$STATE_DIR/admin-enabled"
readonly MAINTENANCE_DIR=/var/lib/quiet-room-deploy
readonly MAINTENANCE_FILE="$MAINTENANCE_DIR/maintenance"
readonly STARTUP_HEALTH_OVERLAY=/etc/quiet-room/startup-health.compose.yaml
readonly STARTUP_HEALTH_DIGEST=8f112e610cede4eea34471f1d7f214ddee84e34046b5916b94f62f90742c45e2
readonly PROJECT=quiet-room
readonly DATA_VOLUME=quiet-room_quiet-room-data
readonly LOCAL_HEALTH_URL=http://127.0.0.1:8080/api/health
if [[ -f /etc/quiet-room/deployment.json ]]; then
  public_host_value="$(python3 -c '
import json, os, re
p="/etc/quiet-room/deployment.json"
s=os.lstat(p)
if s.st_uid != 0 or s.st_mode & 0o022 or not __import__("stat").S_ISREG(s.st_mode): raise ValueError("Unsafe environment configuration")
h=json.load(open(p))["publicHost"]
if not isinstance(h,str) or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]*",h): raise ValueError("Invalid environment host")
print(h)
')"
  readonly PUBLIC_HOST="$public_host_value"
else
  readonly PUBLIC_HOST=ai.shui.click
fi
readonly PUBLIC_ORIGIN="https://$PUBLIC_HOST"
readonly PUBLIC_HEALTH_URL="$PUBLIC_ORIGIN/api/health"
readonly PUBLIC_WEBSOCKET_URL="wss://$PUBLIC_HOST/ws"
readonly GIT_SSH_COMMAND_VALUE='ssh -o BatchMode=yes -o IdentitiesOnly=yes -i /home/deploy/.ssh/github_shui_im'
readonly RELEASE_RETENTION_COUNT="${QUIET_ROOM_RELEASE_RETENTION_COUNT:-3}"
readonly PREDEPLOY_BACKUP_RETENTION_COUNT="${QUIET_ROOM_PREDEPLOY_BACKUP_RETENTION_COUNT:-3}"

if [[ $# -eq 1 && "$1" == --describe ]]; then
  printf '{"imageProtocol":1,"expectedPreviousProtocol":1,"stagedImageProtocol":1,"startupHealthProtocol":1,"publicOrigin":"%s"}\n' "$PUBLIC_ORIGIN"
  exit 0
fi

mode=deploy
if [[ "${1:-}" == --stage || "${1:-}" == --activate ]]; then mode="${1#--}"; shift; fi
readonly REQUESTED_SHA="${1:-}"
readonly REQUESTED_IMAGE_ID="${2:-}"
readonly REQUESTED_ARCHIVE_SHA="${3:-}"
readonly EXPECTED_PREVIOUS_SHA="${4:-}"
if [[ ! "$REQUESTED_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'A lowercase 40-character Git commit is required.\n' >&2
  exit 64
fi
if [[ ( $# -ne 3 && $# -ne 4 ) || ! "$REQUESTED_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ || ! "$REQUESTED_ARCHIVE_SHA" =~ ^[0-9a-f]{64}$ || ( $# -eq 4 && ! "$EXPECTED_PREVIOUS_SHA" =~ ^[0-9a-f]{40}$ ) ]]; then
  printf 'An exact CI image ID and archive checksum are required; server builds are disabled.\n' >&2
  exit 64
fi

if [[ "$mode" != deploy && ( $# -ne 4 || -z "$EXPECTED_PREVIOUS_SHA" ) ]]; then
  printf 'Staging and activation require the exact previous production SHA.\n' >&2
  exit 64
fi

if ! [[ "$RELEASE_RETENTION_COUNT" =~ ^[1-9][0-9]*$ ]] || ! [[ "$PREDEPLOY_BACKUP_RETENTION_COUNT" =~ ^[1-9][0-9]*$ ]]; then
  printf 'Retention counts must be positive integers.\n' >&2
  exit 64
fi

exec 9>/run/lock/quiet-room-deploy.lock
if ! flock -n 9; then
  printf 'Another Quiet Room deployment is already running.\n' >&2
  exit 75
fi

# Cloud delivery binds its read-only preflight to the state under the same
# deployment lock. A concurrent release cannot turn an approved update into a
# downgrade. Legacy three-argument callers retain their existing protocol.
if [[ -n "$EXPECTED_PREVIOUS_SHA" ]]; then
  if [[ ! -f "$STATE_DIR/current-sha" || "$(<"$STATE_DIR/current-sha")" != "$EXPECTED_PREVIOUS_SHA" || "$EXPECTED_PREVIOUS_SHA" == "$REQUESTED_SHA" ]]; then
    printf 'PRODUCTION_STATE_CHANGED: inspect production; do not repeat deployment.\n' >&2
    exit 75
  fi
fi

for required in docker git runuser curl tar flock stat python3; do
  command -v "$required" >/dev/null || {
    printf 'Missing required command: %s\n' "$required" >&2
    exit 69
  }
done

[[ -d "$REPOSITORY" ]] || {
  printf 'Missing deployment repository: %s\n' "$REPOSITORY" >&2
  exit 66
}

[[ -f "$SHARED_ENV" ]] || {
  printf 'Missing production environment file: %s\n' "$SHARED_ENV" >&2
  exit 66
}

[[ ! -e "$MAINTENANCE_FILE" ]] || {
  printf 'An earlier deployment left the business-traffic gate closed. Inspect it before retrying.\n' >&2
  exit 75
}

install -d -o deploy -g deploy -m 0750 "$RELEASES"
install -d -m 0750 "$STATE_DIR" "$BACKUP_DIR"
# Nginx workers must be able to stat this root-owned, persistent marker.
# Keep it separate from the private deployment-state directory.
install -d -o root -g root -m 0755 "$MAINTENANCE_DIR"

# Installed separately from the exact reviewed governance commit. Fail closed
# before fetching/building if capacity protection is missing or unhealthy.
/usr/local/sbin/quiet-room-capacity preflight

deploy_phase_start fetch-source
runuser -u deploy -- env GIT_SSH_COMMAND="$GIT_SSH_COMMAND_VALUE" \
  git --git-dir="$REPOSITORY" fetch --prune origin refs/heads/main:refs/heads/main

resolved_sha="$(runuser -u deploy -- git --git-dir="$REPOSITORY" rev-parse "$REQUESTED_SHA^{commit}")"
if [[ "$resolved_sha" != "$REQUESTED_SHA" ]]; then
  printf 'The requested object is not the exact commit supplied.\n' >&2
  exit 65
fi

if ! runuser -u deploy -- git --git-dir="$REPOSITORY" merge-base --is-ancestor "$REQUESTED_SHA" refs/heads/main; then
  printf 'Refusing to deploy a commit that is not on origin/main.\n' >&2
  exit 65
fi
if [[ -n "$EXPECTED_PREVIOUS_SHA" ]] && ! runuser -u deploy -- git --git-dir="$REPOSITORY" merge-base --is-ancestor "$EXPECTED_PREVIOUS_SHA" "$REQUESTED_SHA"; then
  printf 'Refusing a production downgrade or divergent release.\n' >&2
  exit 65
fi

# Staged state is root-owned and never sourced as shell input.
readonly STAGED_DIR="$STATE_DIR/staged"
install -d -o root -g root -m 0700 "$STAGED_DIR"
prepared_dir=''
if [[ "$mode" == activate ]]; then
  prepared_dir="$(python3 - "$STAGED_DIR/$REQUESTED_SHA.json" "$REQUESTED_SHA" "$REQUESTED_IMAGE_ID" "$REQUESTED_ARCHIVE_SHA" "$EXPECTED_PREVIOUS_SHA" "$RELEASES" <<'PY_STAGE_READ'
import json,os,stat,sys,time
p,sha,image,archive,previous,root=sys.argv[1:]
st=os.lstat(p)
if st.st_uid!=0 or st.st_mode&0o022 or not stat.S_ISREG(st.st_mode): raise ValueError('Unsafe staged receipt')
r=json.load(open(p))
if r.get('version')!=1 or [r.get(k) for k in ('sha','imageId','archiveSha256','previousSha')]!=[sha,image,archive,previous]: raise ValueError('Staged identity mismatch')
if type(r.get('preparedAt')) is not int or type(r.get('expiresAt')) is not int or not r['preparedAt']<=time.time()<r['expiresAt'] or r['expiresAt']-r['preparedAt']!=7200: raise ValueError('Staged candidate expired')
d=r.get('releaseDirectory','')
if not d.startswith(root+'/staged-') or os.path.dirname(d)!=root or os.path.realpath(d)!=d or not os.path.isdir(d): raise ValueError('Unsafe staged checkout')
print(d)
PY_STAGE_READ
)"
  if [[ "$(runuser -u deploy -- git -C "$prepared_dir" rev-parse HEAD)" != "$REQUESTED_SHA" || -n "$(runuser -u deploy -- git -C "$prepared_dir" status --porcelain --untracked-files=all)" ]]; then
    printf 'Staged checkout changed; refusing activation.\n' >&2; exit 65
  fi
elif [[ "$mode" == stage ]]; then
  live_identity="$(docker inspect quiet-room-quiet-room-1 --format '{{.Id}} {{.Image}} {{.State.StartedAt}} {{.State.Running}} {{.State.Health.Status}}')"
  [[ "$live_identity" == *' true healthy' ]] || { printf 'Live application must be healthy before online staging.\n' >&2; exit 75; }
  curl --fail --silent --show-error --max-time 10 "$PUBLIC_HEALTH_URL" >/dev/null
  [[ ! -e "$STAGED_DIR/$REQUESTED_SHA.json" ]] || { printf 'Candidate already staged; inspect before repeating.\n' >&2; exit 75; }
  python3 - "$STAGED_DIR" <<'PY_STAGE_BUDGET'
import glob,os,sys
if len(glob.glob(sys.argv[1]+'/'+'?'*40+'.json'))>=2: raise ValueError('Two staged candidates retained; inspect before preparing another')
if os.getloadavg()[0]>max(1,os.cpu_count() or 1): raise ValueError('Host load too high for online staging')
mem=dict((k,int(v.split()[0])) for k,v in (line.split(':',1) for line in open('/proc/meminfo')))
if mem.get('MemAvailable',0)<512*1024: raise ValueError('Insufficient online staging memory headroom')
PY_STAGE_BUDGET
fi

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
short_sha="${REQUESTED_SHA:0:12}"
release_dir="$RELEASES/$stamp-$short_sha"
if [[ "$mode" == stage ]]; then release_dir="$RELEASES/staged-$stamp-$short_sha"; fi
new_image="quiet-room-app:$REQUESTED_SHA"

if [[ -e "$release_dir" ]]; then
  printf 'Release directory already exists: %s\n' "$release_dir" >&2
  exit 73
fi

deploy_phase_start prepare-release
if [[ "$mode" == activate ]]; then
  # Consume once before entering the cutover path; unknown outcomes are not replayed.
  mv "$STAGED_DIR/$REQUESTED_SHA.json" "$STAGED_DIR/$REQUESTED_SHA.activating-$stamp.json"
  runuser -u deploy -- git --git-dir="$REPOSITORY" worktree move "$prepared_dir" "$release_dir"
else
  runuser -u deploy -- git --git-dir="$REPOSITORY" worktree add --detach "$release_dir" "$REQUESTED_SHA"
fi

# Once ciphertext has been evicted, an older client/server cannot consume the
# signed gaps. Reject a downgrade before build, downtime, or data restoration.
if ! grep -Fxq '{"mlsWindow":1}' "$release_dir/server/storage-capabilities.json" 2>/dev/null; then
  if ! docker exec quiet-room-quiet-room-1 node --input-type=module -e '
    import { DatabaseSync } from "node:sqlite";
    import path from "node:path";
    const db = new DatabaseSync(path.join(process.env.DATA_DIR || "/app/data", "quiet-room.sqlite"), { readOnly: true });
    try {
      const hasWindow = db.prepare("PRAGMA table_info(rooms)").all().some(column => column.name === "window_enabled");
      if (hasWindow && db.prepare("SELECT 1 FROM rooms WHERE window_enabled = 1 LIMIT 1").get()) process.exitCode = 78;
    } finally { db.close(); }
  '; then
    printf 'MESSAGE_WINDOW_DOWNGRADE_BLOCKED: keep a release that supports signed message windows.\n' >&2
    exit 78
  fi
fi

deploy_phase_start import-ci-image
if [[ "${mode:-deploy}" != activate ]]; then
# The publisher verifies the exact successful CI run/attempt and archive before
# streaming it. No full image archive or build cache is stored on the host.
python3 -c '
import hashlib, subprocess, sys
h=hashlib.sha256(); total=0
p=subprocess.Popen(["docker","image","load"],stdin=subprocess.PIPE,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
try:
 while True:
  chunk=sys.stdin.buffer.read(1024*1024)
  if not chunk: break
  total+=len(chunk)
  if total>2*1024**3: raise ValueError("Image archive exceeds limit")
  h.update(chunk); p.stdin.write(chunk)
 p.stdin.close()
 status=p.wait(timeout=600)
 if status or h.hexdigest()!=sys.argv[1]: raise ValueError("CI image transfer failed verification")
except BaseException:
 p.kill(); p.wait(); raise
' "$REQUESTED_ARCHIVE_SHA"
fi
actual_image_id="$(docker image inspect "$new_image" --format '{{.Id}}')"
actual_revision="$(docker image inspect "$new_image" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
actual_platform="$(docker image inspect "$new_image" --format '{{.Os}}/{{.Architecture}}')"
case "$(uname -m)" in
  x86_64) expected_platform=linux/amd64;;
  aarch64|arm64) expected_platform=linux/arm64;;
  *) printf 'Unsupported host architecture.\n' >&2; exit 64;;
esac
if [[ "$actual_image_id" != "$REQUESTED_IMAGE_ID" || "$actual_revision" != "$REQUESTED_SHA" || "$actual_platform" != "$expected_platform" ]]; then
  printf 'Imported CI image does not match the approved commit, image ID or host architecture.\n' >&2
  exit 65
fi

if [[ "${mode:-deploy}" == stage ]]; then
  /usr/local/sbin/quiet-room-capacity preflight
  curl --fail --silent --show-error --max-time 10 "$PUBLIC_HEALTH_URL" >/dev/null
  [[ "$(docker inspect quiet-room-quiet-room-1 --format '{{.Id}} {{.Image}} {{.State.StartedAt}} {{.State.Running}} {{.State.Health.Status}}')" == "$live_identity" ]] || { printf 'Live application changed during online staging.\n' >&2; exit 75; }
  [[ "$(<"$STATE_DIR/current-sha")" == "$EXPECTED_PREVIOUS_SHA" ]] || { printf 'Production changed during stage.\n' >&2; exit 75; }
  python3 - "$STAGED_DIR/$REQUESTED_SHA.json" "$REQUESTED_SHA" "$REQUESTED_IMAGE_ID" "$REQUESTED_ARCHIVE_SHA" "$EXPECTED_PREVIOUS_SHA" "$release_dir" <<'PY_STAGE_WRITE'
import json,os,sys,time
p,sha,image,archive,previous,d=sys.argv[1:]
now=int(time.time())
fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
with os.fdopen(fd,'w') as f:
 json.dump(dict(version=1,sha=sha,imageId=image,archiveSha256=archive,previousSha=previous,releaseDirectory=d,preparedAt=now,expiresAt=now+7200),f); f.write('\n'); f.flush(); os.fsync(f.fileno())
print('STAGE_OK sha='+sha+' image='+image)
PY_STAGE_WRITE
  exit 0
fi

deploy_phase_start compose-preflight
previous_image="$(docker inspect quiet-room-quiet-room-1 --format '{{.Config.Image}}' 2>/dev/null || true)"
previous_release="$(readlink -f "$APP_ROOT/current" 2>/dev/null || true)"
if [[ -n "$previous_release" && -f "$previous_release/compose.yaml" ]]; then
  previous_compose="$previous_release/compose.yaml"
else
  previous_compose="$APP_ROOT/compose.yaml"
fi

# Calling is a persistent, administrator-controlled deployment choice, not a
# transient local --profile flag. Never source a credentials file as shell code.
new_compose_args=(--project-name "$PROJECT" --env-file "$SHARED_ENV" --file "$release_dir/compose.yaml")
previous_compose_args=(--project-name "$PROJECT" --env-file "$SHARED_ENV" --file "$previous_compose")
if [[ -e "$STARTUP_HEALTH_OVERLAY" || -L "$STARTUP_HEALTH_OVERLAY" ]]; then
  python3 - "$STARTUP_HEALTH_OVERLAY" "$STARTUP_HEALTH_DIGEST" <<'PY_HEALTH_CONFIG'
import hashlib,os,stat,sys
p,digest=sys.argv[1:]; s=os.lstat(p)
if s.st_uid!=0 or s.st_mode&0o022 or not stat.S_ISREG(s.st_mode) or hashlib.sha256(open(p,'rb').read()).hexdigest()!=digest: raise ValueError('Unsafe startup health overlay')
PY_HEALTH_CONFIG
  python3 - "$(docker version --format '{{.Server.Version}}')" "$(docker compose version --short)" <<'PY_HEALTH_VERSION'
import re,sys
v=lambda s: tuple(map(int,re.findall(r'\d+',s)[:3]))
if v(sys.argv[1])<(25,0,0) or v(sys.argv[2])<(2,20,2): raise ValueError('Startup health overlay requires Engine >=25 and Compose >=2.20.2')
PY_HEALTH_VERSION
  new_compose_args+=(--file "$STARTUP_HEALTH_OVERLAY")
  previous_compose_args+=(--file "$STARTUP_HEALTH_OVERLAY")
fi
calls_enabled=0
previous_calls_enabled=0
existing_turn="$(docker ps --all --quiet --filter "label=com.docker.compose.project=$PROJECT" --filter 'label=com.docker.compose.service=quiet-room-turn')"
if [[ -n "$existing_turn" || ( -f "$CALLS_STATE" && "$(<"$CALLS_STATE")" == 1 ) ]]; then
  previous_calls_enabled=1
fi
if [[ -e "$CALLS_ENV" || -L "$CALLS_ENV" ]]; then
  shared_mode="$(stat -c '%a' "$APP_ROOT/shared")"
  if [[ -L "$APP_ROOT/shared" || "$(stat -c '%u' "$APP_ROOT/shared")" != 0 || ! "$shared_mode" =~ ^[0-7]{3,4}$ ]] ||
      (( (8#$shared_mode & 022) != 0 )); then
    printf 'Calling settings directory must be root-owned and not group/other writable.\n' >&2
    exit 66
  fi
  if [[ ! -f "$CALLS_ENV" || -L "$CALLS_ENV" || "$(stat -c '%u:%a' "$CALLS_ENV")" != '0:600' ]]; then
    printf 'Calling environment must be a root-owned mode-0600 regular file: %s\n' "$CALLS_ENV" >&2
    exit 66
  fi
  if [[ ! -f "$release_dir/compose.calls.yaml" ]]; then
    printf 'Calling is enabled; requested release lacks compose.calls.yaml. Refusing cutover.\n' >&2
    exit 66
  fi
  calls_enabled=1
  new_compose_args+=(--env-file "$CALLS_ENV" --file "$release_dir/compose.calls.yaml" --profile calls)
  if (( previous_calls_enabled )); then
    if [[ ! -f "${previous_compose%/*}/compose.calls.yaml" ]]; then
      printf 'Cannot preserve previously enabled calling during rollback: previous overlay is missing.\n' >&2
      exit 66
    fi
    previous_compose_args+=(--env-file "$CALLS_ENV" --file "${previous_compose%/*}/compose.calls.yaml" --profile calls)
  fi
elif [[ -n "$existing_turn" || ( -f "$CALLS_STATE" && "$(<"$CALLS_STATE")" == 1 ) ]]; then
  printf 'Calling was enabled but its persistent environment file is missing; refusing to remove TURN.\n' >&2
  exit 66
fi

# Administration credentials live outside the rollback data volume. Its
# opt-in is durable across releases, just like calling; never source admin.env.
admin_enabled=0
previous_admin_enabled=0
if [[ -f "$ADMIN_STATE" && "$(<"$ADMIN_STATE")" == 1 ]]; then previous_admin_enabled=1; fi
if [[ -e "$ADMIN_ENV" || -L "$ADMIN_ENV" ]]; then
  admin_shared_mode="$(stat -c '%a' "$APP_ROOT/shared")"
  if [[ -L "$APP_ROOT/shared" || "$(stat -c '%u' "$APP_ROOT/shared")" != 0 || ! "$admin_shared_mode" =~ ^[0-7]{3,4}$ ]] ||
      (( (8#$admin_shared_mode & 022) != 0 )); then
    printf 'Admin settings directory must be root-owned and not group/other writable.\n' >&2
    exit 66
  fi
  if [[ ! -f "$ADMIN_ENV" || -L "$ADMIN_ENV" || "$(stat -c '%u:%a' "$ADMIN_ENV")" != '0:600' ]]; then
    printf 'Admin environment must be a root-owned mode-0600 regular file.\n' >&2
    exit 66
  fi
  if [[ ! -f "$release_dir/compose.admin.yaml" ]]; then
    printf 'Administration is enabled; requested release lacks compose.admin.yaml. Refusing cutover.\n' >&2
    exit 66
  fi
  admin_enabled=1
  new_compose_args+=(--env-file "$ADMIN_ENV" --file "$release_dir/compose.admin.yaml")
  if (( previous_admin_enabled )); then
    if [[ ! -f "${previous_compose%/*}/compose.admin.yaml" ]]; then
      printf 'Cannot preserve administration during rollback: previous overlay is missing.\n' >&2
      exit 66
    fi
    previous_compose_args+=(--env-file "$ADMIN_ENV" --file "${previous_compose%/*}/compose.admin.yaml")
  fi
elif (( previous_admin_enabled )); then
  printf 'Administration was enabled but its persistent environment file is missing; refusing cutover.\n' >&2
  exit 66
fi

# Resolve both graphs before maintenance. --quiet avoids printing interpolated
# TURN secrets. Download the separately reviewed TURN image before downtime.
if (( calls_enabled )); then
  # Git checkout inherits the deployment umask. This tracked file is public
  # configuration, mounted read-only by the unprivileged TURN container.
  turn_public_config="$release_dir/deploy/turnserver.conf"
  if [[ ! -f "$turn_public_config" || -L "$turn_public_config" ]]; then
    printf 'TURN public configuration must be a regular, non-symlink file.\n' >&2
    exit 66
  fi
  chmod 0644 "$turn_public_config"
fi
QUIET_ROOM_IMAGE="$new_image" docker compose "${new_compose_args[@]}" config --quiet
admin_origin=''
if (( admin_enabled )); then
  # Resolve only the effective origin through Compose; never source admin.env
  # or print the rest of the interpolated configuration (which has secrets).
  admin_origin="$(QUIET_ROOM_IMAGE="$new_image" docker compose "${new_compose_args[@]}" config --format json | python3 -c '
import json, re, sys
origin=json.load(sys.stdin)["services"]["quiet-room"]["environment"].get("ADMIN_ORIGIN")
if not isinstance(origin,str) or not re.fullmatch(r"https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?/?",origin): raise ValueError("Invalid administrator origin")
print(origin.rstrip("/"))
')"
fi
if [[ -f "$previous_compose" ]]; then
  QUIET_ROOM_IMAGE="${previous_image:-$new_image}" docker compose "${previous_compose_args[@]}" config --quiet
fi
if (( calls_enabled )); then
  QUIET_ROOM_IMAGE="$new_image" docker compose "${new_compose_args[@]}" pull quiet-room-turn
fi

cutover_started=0
data_restore_required=0
backup_ready=0
backup_name=''
backup_path=''
failed_cutover_backup_path=''
deploy_phase_start public-preflight

wait_for_health() {
  local attempt
  for attempt in $(seq 1 30); do
    if curl --fail --silent --show-error --max-time 3 "$LOCAL_HEALTH_URL" | grep -q '"ok":true'; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_public_health() {
  local attempts="${1:-10}"
  local attempt
  for attempt in $(seq 1 "$attempts"); do
    if curl --fail --silent --show-error --max-time 5 "$PUBLIC_HEALTH_URL" | grep -q '"ok":true'; then
      return 0
    fi
    sleep 2
  done
  return 1
}

close_business_traffic() {
  printf '%s\n' "$REQUESTED_SHA" > "$MAINTENANCE_FILE"
  chmod 0644 "$MAINTENANCE_FILE"
}

open_business_traffic() {
  rm -- "$MAINTENANCE_FILE"
}

probe_public_maintenance() {
  local route status
  for route in /api/rooms /api/rooms/__deployment_probe__ /ws; do
    status="$(curl --silent --show-error --connect-timeout 3 --max-time 5 \
      --output /dev/null --write-out '%{http_code}' "$PUBLIC_ORIGIN$route")" || return 1
    if [[ "$status" != 503 ]]; then
      printf 'Business-traffic gate is ineffective for %s: HTTP %s\n' "$route" "$status" >&2
      return 1
    fi
  done
  if (( admin_enabled || previous_admin_enabled )); then
    status="$(curl --silent --show-error --connect-timeout 3 --max-time 5 \
      --output /dev/null --write-out '%{http_code}' "$admin_origin/admin-api/rooms")" || return 1
    if [[ "$status" != 503 ]]; then
      printf 'Admin traffic gate is ineffective: HTTP %s\n' "$status" >&2
      return 1
    fi
  fi
}

probe_local_websocket() {
  docker run --rm --network host \
    --env "QUIET_ROOM_PUBLIC_ORIGIN=$PUBLIC_ORIGIN" \
    --env "QUIET_ROOM_PUBLIC_HOST=$PUBLIC_HOST" \
    "$new_image" node --input-type=module -e \
    "import WebSocket from 'ws'; let opened=false; const w=new WebSocket('ws://127.0.0.1:8080/ws',{headers:{Origin:process.env.QUIET_ROOM_PUBLIC_ORIGIN,Host:process.env.QUIET_ROOM_PUBLIC_HOST}}); const t=setTimeout(()=>process.exit(2),5000); w.on('open',()=>{opened=true;w.close()}); w.on('close',()=>{clearTimeout(t);process.exit(opened?0:3)}); w.on('error',()=>process.exit(1));"
}

probe_public_websocket() {
  docker run --rm --network host \
    --env "QUIET_ROOM_PUBLIC_ORIGIN=$PUBLIC_ORIGIN" \
    --env "QUIET_ROOM_PUBLIC_WEBSOCKET_URL=$PUBLIC_WEBSOCKET_URL" \
    "$new_image" node --input-type=module -e \
    "import WebSocket from 'ws'; let opened=false; const w=new WebSocket(process.env.QUIET_ROOM_PUBLIC_WEBSOCKET_URL,{headers:{Origin:process.env.QUIET_ROOM_PUBLIC_ORIGIN}}); const t=setTimeout(()=>process.exit(2),5000); w.on('open',()=>{opened=true;w.close()}); w.on('close',()=>{clearTimeout(t);process.exit(opened?0:3)}); w.on('error',()=>process.exit(1));"
}

wait_for_public_websocket() {
  local attempt
  for attempt in $(seq 1 5); do
    if probe_public_websocket; then
      return 0
    fi
    sleep 2
  done
  return 1
}

project_container_ids() {
  docker ps --quiet --filter "label=com.docker.compose.project=$PROJECT"
}

all_project_container_ids() {
  docker ps --all --quiet --filter "label=com.docker.compose.project=$PROJECT"
}

stop_project_containers() {
  local listing
  local remaining
  local attempt
  local -a containers=()

  # Include exited/restarting containers so an unless-stopped restart policy
  # cannot bring a failed new process back while its volume is being archived.
  listing="$(all_project_container_ids)" || return 1
  while IFS= read -r container; do
    [[ -n "$container" ]] && containers+=("$container")
  done <<< "$listing"

  if (( ${#containers[@]} > 0 )); then
    # docker stop sends SIGTERM first, allowing SQLite to checkpoint and close,
    # and marks the unless-stopped containers as explicitly stopped.
    if ! docker stop "${containers[@]}"; then
      printf 'WARNING: docker stop returned an error; verifying container state.\n' >&2
    fi
  fi

  # The stop response can precede the daemon's container-list update. Keep
  # traffic gated and require the same empty running list, with a bounded wait.
  # A query error or containers that never stop still fails closed.
  for attempt in {1..10}; do
    remaining="$(project_container_ids)" || return 1
    [[ -z "$remaining" ]] && return 0
    if (( attempt < 10 )); then sleep 1; fi
  done
  printf 'Project containers are still running after stop: %s\n' "$remaining" >&2
  return 1
}

ensure_data_volume_quiescent() {
  local users
  users="$(docker ps --quiet --filter "volume=$DATA_VOLUME")" || return 1
  if [[ -n "$users" ]]; then
    printf 'Refusing cold-data operation; running containers still mount %s: %s\n' \
      "$DATA_VOLUME" "$users" >&2
    return 1
  fi
}

validate_data_archive() {
  local archive_path="$1"
  local member
  local normalized

  if [[ ! -f "$archive_path" || ! -s "$archive_path" ]]; then
    printf 'Data archive is missing or empty: %s\n' "$archive_path" >&2
    return 1
  fi
  tar -tzf "$archive_path" >/dev/null || {
    printf 'Data archive failed gzip/tar verification: %s\n' "$archive_path" >&2
    return 1
  }

  # The archive is generated from the application volume, but reject unsafe
  # member paths again before any root-owned extraction into that volume.
  while IFS= read -r member; do
    normalized="${member#./}"
    if [[ "$normalized" == /* || "$normalized" == '..' || "$normalized" == ../* ||
      "$normalized" == */../* || "$normalized" == */.. ]]; then
      printf 'Data archive contains an unsafe member path: %s\n' "$member" >&2
      return 1
    fi
  done < <(tar -tzf "$archive_path")
}

create_data_archive() {
  local image="$1"
  local archive_name="$2"
  local archive_path="$BACKUP_DIR/$archive_name"

  ensure_data_volume_quiescent || return 1
  if [[ ! "$archive_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf 'Unsafe data archive name: %s\n' "$archive_name" >&2
    return 1
  fi
  if [[ -e "$archive_path" ]]; then
    printf 'Refusing to overwrite data archive: %s\n' "$archive_path" >&2
    return 1
  fi

  printf 'Creating cold data archive: %s\n' "$archive_path" >&2
  docker run --rm --user 0 \
    --volume "$DATA_VOLUME:/data:ro" \
    --volume "$BACKUP_DIR:/backup" \
    --env "ARCHIVE_NAME=$archive_name" \
    "$image" \
    sh -ceu '
      umask 077
      case "$ARCHIVE_NAME" in
        ""|*[!A-Za-z0-9._-]*) exit 64 ;;
      esac
      partial="/backup/.${ARCHIVE_NAME}.partial"
      final="/backup/${ARCHIVE_NAME}"
      cleanup() { rm -f -- "$partial"; }
      trap cleanup EXIT HUP INT TERM
      test ! -e "$final"
      rm -f -- "$partial"
      tar -czf "$partial" -C /data .
      tar -tzf "$partial" >/dev/null
      mv -- "$partial" "$final"
      trap - EXIT HUP INT TERM
    '

  validate_data_archive "$archive_path"
  printf 'Verified cold data archive: %s\n' "$archive_path" >&2
}

restore_data_archive() {
  local image="$1"
  local archive_path="$2"
  local archive_name="${archive_path##*/}"

  ensure_data_volume_quiescent || return 1
  validate_data_archive "$archive_path" || return 1
  if [[ "$archive_path" != "$BACKUP_DIR/$archive_name" || ! "$archive_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf 'Refusing to restore an archive outside the predeploy directory: %s\n' "$archive_path" >&2
    return 1
  fi

  printf 'Restoring predeploy data archive: %s\n' "$archive_path" >&2
  docker run --rm --user 0 \
    --volume "$DATA_VOLUME:/data" \
    --volume "$BACKUP_DIR:/backup:ro" \
    --env "ARCHIVE_NAME=$archive_name" \
    "$image" \
    sh -ceu '
      case "$ARCHIVE_NAME" in
        ""|*[!A-Za-z0-9._-]*) exit 64 ;;
      esac
      archive="/backup/${ARCHIVE_NAME}"
      test -s "$archive"
      tar -tzf "$archive" >/dev/null
      find /data -mindepth 1 -maxdepth 1 -exec rm -rf -- {} \;
      tar -xzf "$archive" -C /data
    '
  printf 'Restored predeploy data archive: %s\n' "$archive_path" >&2
}

prune_successful_deployments() {
  # Release worktrees and images are pruned by the bounded daily governor,
  # using the successful-release registry and failed-cutover protection.
  # Pre-deploy archives are ciphertext-only rollback points. Retain a bounded
  # number by mtime and never touch continuous/off-host backups.
  mapfile -t old_backups < <(
    find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type f -name 'data-*.tar.gz' -printf '%T@ %p\n' |
      sort -nr |
      tail -n +$((PREDEPLOY_BACKUP_RETENTION_COUNT + 1)) |
      cut -d' ' -f2-
  )
  for backup in "${old_backups[@]}"; do
    [[ -n "$backup" ]] || continue
    [[ -e "$BACKUP_DIR/failed-cutover-${backup##*/data-}" ]] && continue
    rm -f -- "$backup"
  done
}

rollback() {
  local exit_code="$1"
  local rollback_image="${previous_image:-$new_image}"
  local failed_cutover_backup_name
  local restored_backup_path='not-required'
  trap - ERR
  deploy_phase_finish failure
  deploy_phase_start rollback

  rollback_fail_closed() {
    local reason="$1"
    printf 'ROLLBACK_FAILED original_exit=%s reason=%s\n' "$exit_code" "$reason" >&2
    [[ -f "$backup_path" ]] && printf 'Predeploy backup retained at: %s\n' "$backup_path" >&2
    [[ -n "$failed_cutover_backup_path" && -f "$failed_cutover_backup_path" ]] &&
      printf 'Failed-cutover data retained at: %s\n' "$failed_cutover_backup_path" >&2
    printf 'No further automatic changes will be attempted; verify container state and recover manually.\n' >&2
    exit 70
  }

  printf 'Deployment failed; beginning data-safe rollback (original exit %s).\n' "$exit_code" >&2
  if ! stop_project_containers; then
    rollback_fail_closed 'could-not-stop-new-containers'
  fi
  if ! ensure_data_volume_quiescent; then
    rollback_fail_closed 'data-volume-still-has-running-users'
  fi

  if (( data_restore_required )); then
    if (( ! backup_ready )) || [[ -z "$backup_path" ]]; then
      rollback_fail_closed 'verified-predeploy-backup-is-missing'
    fi

    # Public business traffic has remained gated since before the cold backup.
    # Preserve possible migrations for diagnosis; no new client ACK can have
    # been issued against this rollback-eligible database through the proxy.
    failed_cutover_backup_name="failed-cutover-$stamp-$short_sha.tar.gz"
    if ! create_data_archive "$rollback_image" "$failed_cutover_backup_name"; then
      rollback_fail_closed 'could-not-preserve-failed-cutover-data'
    fi
    failed_cutover_backup_path="$BACKUP_DIR/$failed_cutover_backup_name"
    if ! restore_data_archive "$rollback_image" "$backup_path"; then
      rollback_fail_closed 'could-not-restore-predeploy-backup'
    fi
    restored_backup_path="$backup_path"
  fi

  if [[ -z "$previous_image" || ! -f "$previous_compose" ]]; then
    rollback_fail_closed 'previous-release-is-unavailable'
  fi
  if ! QUIET_ROOM_IMAGE="$previous_image" docker compose "${previous_compose_args[@]}" \
    up --detach --no-build --remove-orphans; then
    if ! stop_project_containers; then
      rollback_fail_closed 'could-not-stop-partial-previous-release'
    fi
    rollback_fail_closed 'could-not-start-previous-release'
  fi
  if ! wait_for_health; then
    if ! stop_project_containers; then
      rollback_fail_closed 'could-not-stop-unhealthy-previous-release'
    fi
    rollback_fail_closed 'previous-release-did-not-become-healthy'
  fi

  if ! wait_for_public_health 3 || ! probe_public_maintenance; then
    rollback_fail_closed 'previous-release-public-route-or-traffic-gate-failed'
  fi
  if ! open_business_traffic; then
    rollback_fail_closed 'could-not-reopen-previous-release'
  fi

  printf 'ROLLBACK_OK original_exit=%s restored_backup=%s failed_cutover_backup=%s\n' \
    "$exit_code" "$restored_backup_path" "${failed_cutover_backup_path:-not-created}" >&2
  deploy_phase_finish success
  exit "$exit_code"
}

trap 'exit_code=$?; if (( cutover_started )); then rollback "$exit_code"; else exit "$exit_code"; fi' ERR

running_container_listing="$(project_container_ids)"
if [[ -n "$running_container_listing" && ( -z "$previous_image" || ! -f "$previous_compose" ) ]]; then
  printf 'Refusing cutover: running production containers have no recoverable previous release.\n' >&2
  exit 66
fi

# Refuse to begin downtime when DNS/TLS/reverse-proxy routing for the canonical
# origin is already broken. The same probe is retried after cutover below.
if ! wait_for_public_health 3; then
  printf 'Refusing cutover: canonical public health check is unavailable: %s\n' "$PUBLIC_HEALTH_URL" >&2
  exit 69
fi

# Validate the installed proxy, not merely the checked-in Nginx file. Nothing
# has stopped or changed data yet, so a missing gate aborts without downtime.
deploy_phase_start gate-traffic
/usr/local/sbin/quiet-room-capacity preflight
close_business_traffic
if ! probe_public_maintenance || ! wait_for_public_health 3; then
  open_business_traffic
  printf 'Refusing cutover: install and validate the Nginx traffic gate first.\n' >&2
  exit 69
fi

deploy_phase_start stop-containers
cutover_started=1
stop_project_containers
ensure_data_volume_quiescent

deploy_phase_start cold-backup
backup_name="data-$stamp-$short_sha.tar.gz"
backup_path="$BACKUP_DIR/$backup_name"
backup_image="${previous_image:-$new_image}"
create_data_archive "$backup_image" "$backup_name"
backup_ready=1

deploy_phase_start start-containers
data_restore_required=1
QUIET_ROOM_IMAGE="$new_image" docker compose "${new_compose_args[@]}" \
  up --detach --no-build --remove-orphans

deploy_phase_start validate-gated-service
wait_for_health
wait_for_public_health 10
probe_local_websocket
probe_public_maintenance

# The validation window is over. From this point forward a failure must retain
# the current database: clients may receive ACKs as soon as the gate is opened.
# Metadata publication failures leave the gate closed for manual recovery.
data_restore_required=0
cutover_started=0
trap - ERR

deploy_phase_start publish-state
ln -sfn "$release_dir" "$APP_ROOT/current"
printf '%s\n' "$REQUESTED_SHA" > "$STATE_DIR/current-sha"
printf '%s\n' "$stamp" > "$STATE_DIR/deployed-at"
printf '%s\n' "$calls_enabled" > "$CALLS_STATE"
printf '%s\n' "$admin_enabled" > "$ADMIN_STATE"
docker image tag "$new_image" quiet-room-app:production
open_business_traffic
deploy_phase_start verify-public-websocket
if ! wait_for_public_websocket; then
  printf 'POST_OPEN_CHECK_FAILED sha=%s; current database retained; automatic data rollback is disabled.\n' "$REQUESTED_SHA" >&2
  exit 70
fi

# The registry only advances after the open-service validation passed.
# Independent readback is still required by the publisher before task completion.
printf '%s %s\n' "$stamp" "$REQUESTED_SHA" >> "$MAINTENANCE_DIR/successful-releases"

deploy_phase_start prune
prune_successful_deployments || {
  deploy_phase_finish failure
  printf 'WARNING: release/backup pruning failed; retain current deployment.\n' >&2
}
deploy_phase_finish success

printf 'DEPLOY_OK sha=%s release=%s backup=%s\n' \
  "$REQUESTED_SHA" "$release_dir" "$BACKUP_DIR/$backup_name"
